{
  "name": "iwg-crm",
  "private": true,
  "version": "1.0.0",
  "description": "IWG CRM — AI-first Medicare insurance CRM for I Will Global",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node -e \"const {spawn}=require('child_process');['dev:server','dev:client'].forEach(s=>spawn('npm',['run',s],{stdio:'inherit',shell:true}))\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "build:api": "npx esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "build": "npm run build:api && npm run build --workspace client",
    "publish": "npm run build",
    "start": "npm run start --workspace server"
  },
  "dependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "type": "module",
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}