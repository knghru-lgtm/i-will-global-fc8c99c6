# Core Google Cloud Server & Host Configuration
PORT=4000
APP_URL=https://voice.iwillglobal.com
PUBLIC_HOST_FQDN=voice.iwillglobal.com

# Headless 24/7 Google Cloud VoIP Daemon for Sarah (+14803319455)
CLOUD_TELEPHONY_MODE=true
GOOGLE_VOICE_NUMBER=+14803319455

# Strict Arizona Time Routing (America/Phoenix — MST, UTC-7 year-round, No DST)
OFFICE_TIMEZONE=America/Phoenix
OFFICE_HOURS_START=08:00
OFFICE_HOURS_END=17:00
OFFICE_DAYS=1,2,3,4,5
OFFICE_HOLIDAYS=

# Google GenAI (@google/genai) Live Bidirectional Voice Persona ("Sarah" / Vindemiatrix)
GOOGLE_GENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Cloud Postgres & Google Workspace OAuth
DATABASE_URL=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=iwillglobal.com
