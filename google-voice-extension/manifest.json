{
  "manifest_version": 3,
  "name": "IWG Receptionist — 24/7 Cloud & Google Voice Bridge (480) 331-9455",
  "version": "3.0.0",
  "description": "Cloud-First Zero-Echo Pure Digital WebRTC Receptionist Bridge & Session Sync for (480) 331-9455.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://voice.google.com/*",
    "https://iwillglobal.com/*",
    "http://localhost:4000/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://voice.google.com/*"
      ],
      "js": [
        "webrtc-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://voice.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://iwillglobal.com/*",
        "http://localhost:4000/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "crm-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
