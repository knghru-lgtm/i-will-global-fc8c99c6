{
  "manifest_version": 3,
  "name": "IWG Receptionist — Google Voice Auto-Answer & Caller (480) 331-9455",
  "version": "2.8.0",
  "description": "Internal IWG Cloned App Receptionist Bridge for (480) 331-9455 — WebRTC Direct Audio & 1st-Ring Auto-Answer.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://voice.google.com/*",
    "https://iwillglobal.com/*",
    "http://localhost:4000/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://voice.google.com/*"
      ],
      "js": [
        "webrtc-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://voice.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://iwillglobal.com/*",
        "http://localhost:4000/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "crm-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}