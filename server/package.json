{
  "name": "@iwg/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch-path=src src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "seed": "node --env-file-if-exists=.env src/db/seed.ts --reset",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@google/genai": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.13.0",
    "ws": "^8.22.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "typescript": "~6.0.2"
  }
}
